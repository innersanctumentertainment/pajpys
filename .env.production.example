APP_NAME=PAJPYS
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://pajpys.agapetech.org

DEPLOY_SECRET=generate-a-long-random-string

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_DATABASE is optional; defaults to database/database.sqlite in the app root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.agapetech.org

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=hello@agapetech.org
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=hello@agapetech.org
MAIL_FROM_NAME=PAJPYS

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pajpys.agapetech.org/auth/google/callback

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_WEBHOOK_SECRET=
WIPAY_ENVIRONMENT=sandbox
WIPAY_BASE_URL=https://sandbox.wipayfinancial.com
WIPAY_RESPONSE_URL=https://pajpys.agapetech.org/payments/wipay/response
WIPAY_WEBHOOK_URL=https://pajpys.agapetech.org/payments/wipay/webhook
WIPAY_DEFAULT_CURRENCY=TTD

SEEDER_ADMIN_PASSWORD=change-me-after-first-login
